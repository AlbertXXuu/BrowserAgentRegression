    "browser_workspaces": {
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "action": {
            "default": "list",
            "description": "Use list to discover forkOnly sources even when direct access is disabled; create a fresh task workspace before page tools. Create and resume claim exclusive write ownership. Use ownership-status to inspect it, claim-ownership after fresh inspection to recover it, and release-ownership for handoff. Use resume only after reconnecting, with the private resumeKey returned by create or archive operations.",
            "type": "string",
            "enum": [
              "list",
              "list-fork-sources",
              "create",
              "resume",
              "update",
              "rename",
              "close",
              "list-origins",
              "ownership-status",
              "claim-ownership",
              "release-ownership"
            ]
          },
          "workspaceId": {
            "description": "Stable UUIDv7 id returned by your own create call or by reopening your own archive. Pass this created workspace id to page tools. A rename changes only the human name, never this ID.",
            "type": "string"
          },
          "resumeKey": {
            "description": "Private resume key returned when this workspace was created, archived, resumed, or reopened, or given to you by the person who copied it from Hronaut. Required only for resume. Never share it with another client or website.",
            "type": "string",
            "pattern": "^hrw1_[A-Za-z0-9_-]{43}$"
          },
          "name": {
            "description": "Human-readable workspace name for create, update, or rename.",
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "description": "Durable workspace purpose and context. Describe why it exists, current work, and what useful browser state it stores. Returned by list and resume.",
            "type": "string",
            "maxLength": 1000
          },
          "color": {
            "description": "Visible workspace color for create or update.",
            "type": "string",
            "enum": [
              "gray",
              "blue",
              "cyan",
              "green",
              "yellow",
              "orange",
              "red",
              "pink",
              "purple"
            ]
          },
          "sourceWorkspaceId": {
            "description": "Required with storage=fork-workspace. Choose a forkOnly ID from list or any active or archived ID from list-fork-sources, including sources with direct agent access disabled. Forking never authorizes access to the source.",
            "type": "string"
          },
          "storage": {
            "description": "Required choice for an explicit create workflow: scratch (the default when omitted) starts from a clean isolated profile. fork-workspace copies reusable cookies and localStorage from sourceWorkspaceId into a fresh isolated workspace, inheriting its navigation restrictions. Forks do not copy source tabs. Source direct access may be disabled; the new agent workspace permits direct access. No fork authorizes browsing the original workspace.",
            "type": "string",
            "enum": [
              "scratch",
              "fork-workspace"
            ]
          },
          "origins": {
            "description": "Optional HTTP(S) origins whose cookies and localStorage are copied during fork-workspace. Omit to copy all available cookies and known localStorage from the selected source.",
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "contextClass": {
            "default": "standard",
            "description": "Use public-observer only for a clean, origin-scoped, read-only independent observation workspace.",
            "type": "string",
            "enum": [
              "standard",
              "public-observer"
            ]
          },
          "observerOrigin": {
            "description": "Required with contextClass=public-observer. The clean observer workspace is restricted to this HTTP(S) origin; paths, query values, and fragments are discarded.",
            "type": "string",
            "format": "uri"
          }
        }
      },
